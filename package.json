{
  "name": "how-to-madrid",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "build:analyze": "npm run build && npm run bundle-analyzer",
    "bundle-analyzer": "du -sh dist/ && find dist/ -name '*.js' -o -name '*.css' | head -10 | xargs ls -lh",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run lint && npm run format:check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.8",
    "@inox-tools/content-utils": "0.16.0",
    "@zachleat/snow-fall": "^1.0.3",
    "astro": "^7.4.4",
    "astro-compress": "^2.4.3",
    "astro-og-canvas": "^0.13.2",
    "sharp": "^0.35.5",
    "starlight-links-validator": "^0.27.0",
    "typescript": "^6.0.3",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.1",
    "@eslint/js": "10.0.1",
    "@vitest/ui": "^5.0.5",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.14.0",
    "oxfmt": "0.77.0",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "astro-compress": {
      "deepmerge-ts": "8.0.2",
      "sharp": "$sharp",
      "svgo": "4.1.0"
    },
    "minimatch@>=7 <11.0.1": "11.0.1"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true
  }
}
