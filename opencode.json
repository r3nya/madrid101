{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "formatter": {
    "oxfmt": {
      "command": ["npx", "--no-install", "oxfmt", "--write", "$FILE"],
      "extensions": [
        ".js",
        ".mjs",
        ".ts",
        ".jsx",
        ".tsx",
        ".json",
        ".astro",
        ".md",
        ".mdx",
        ".yaml",
        ".yml"
      ]
    }
  },
  "command": {
    "build": {
      "template": "Run npm run build to build the project",
      "description": "Build the project"
    },
    "lint": {
      "template": "Run npm run check to check code formatting and linting",
      "description": "Check code formatting and linting"
    },
    "format": {
      "template": "Run npm run format to format code",
      "description": "Format code with Oxfmt"
    }
  }
}
