{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "formatter": {
    "oxfmt": {
      "extensions": [
        ".js",
        ".mjs",
        ".ts",
        ".jsx",
        ".tsx",
        ".json",
        ".astro",
        ".md",
        ".mdx",
        ".yaml",
        ".yml"
      ]
    }
  }
}
