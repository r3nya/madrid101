---
interface Props {
  title: string;
  diagram: string;
}

const { title, diagram } = Astro.props;
---

<details data-mermaid={diagram}>
  <summary>{title}</summary>
  <div class="diagram" aria-live="polite"></div>
</details>

<script>
  for (const details of document.querySelectorAll<HTMLDetailsElement>("details[data-mermaid]")) {
    const output = details.querySelector<HTMLElement>(".diagram");
    const definition = details.dataset.mermaid;
    if (!output || !definition) continue;

    let rendering = false;
    let renderedTheme: string | undefined;

    const render = async () => {
      const theme = document.documentElement.dataset.theme === "dark" ? "dark" : "default";
      if (!details.open || rendering || renderedTheme === theme) return;

      rendering = true;
      output.textContent = "Загружаем схему…";
      try {
        const { default: mermaid } = await import("mermaid");
        mermaid.initialize({
          startOnLoad: false,
          layout: "elk",
          look: "neo",
          theme,
          securityLevel: "strict",
          themeVariables: { fontSize: "20px" },
          flowchart: { nodeSpacing: 20, rankSpacing: 30, padding: 10 },
        });
        const { svg } = await mermaid.render(`mermaid-${crypto.randomUUID()}`, definition);
        output.innerHTML = svg;
        renderedTheme = theme;
      } catch (error) {
        output.textContent = "Не удалось загрузить схему. Закройте блок и откройте снова.";
        console.error("Mermaid diagram failed to render", error);
      } finally {
        rendering = false;
      }
    };

    details.addEventListener("toggle", render);
    new MutationObserver(render).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  }
</script>

<style>
  .diagram {
    margin-block: 1rem;
    text-align: center;
  }
  .diagram :global(svg) {
    max-width: 100%;
    height: auto;
  }
</style>
