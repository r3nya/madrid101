---
import { createHash } from "node:crypto";
import { renderMermaid } from "@mermaid-js/mermaid-cli";
import puppeteer from "puppeteer";

interface Props {
  title: string;
  diagram: string;
}

const { title, diagram } = Astro.props;
const id = createHash("sha256").update(diagram).digest("hex").slice(0, 12);
const browser = await puppeteer.launch();
let light: string;
let dark: string;
try {
  const render = async (theme: "default" | "dark") => {
    const { data } = await renderMermaid(browser, diagram, "svg", {
      svgId: `mermaid-${id}-${theme}`,
      backgroundColor: "transparent",
      fontEmbed: false,
      mermaidConfig: {
        layout: "elk",
        look: "neo",
        theme,
        securityLevel: "strict",
        deterministicIds: true,
        deterministicIDSeed: `${id}-${theme}`,
        themeVariables: { fontSize: "20px" },
        flowchart: { nodeSpacing: 20, rankSpacing: 30, padding: 10 },
      },
    });
    return new TextDecoder().decode(data);
  };
  [light, dark] = await Promise.all([render("default"), render("dark")]);
} finally {
  await browser.close();
}
---

<details>
  <summary>{title}</summary>
  <div class="diagram light" set:html={light} />
  <div class="diagram dark" set:html={dark} />
</details>

<style>
  .diagram {
    margin-block: 1rem;
    text-align: center;
  }
  .dark {
    display: none;
  }
  :global([data-theme="dark"]) .light {
    display: none;
  }
  :global([data-theme="dark"]) .dark {
    display: block;
  }
  .diagram :global(svg) {
    max-width: 100%;
    height: auto;
  }
</style>
